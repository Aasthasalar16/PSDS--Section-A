import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();
        int k = sc.nextInt();

        int[][] edge = new int[m][3];

        for (int i = 0; i < m; i++) {
            edge[i][0] = sc.nextInt();
            edge[i][1] = sc.nextInt();
            edge[i][2] = sc.nextInt();
        }

        int INF = 1000000000;

        int[][] dp = new int[k + 1][n + 1];

        for (int i = 0; i <= k; i++) {
            Arrays.fill(dp[i], INF);
        }

        dp[0][1] = 0;

        for (int e = 1; e <= k; e++) {
            for (int i = 0; i < m; i++) {

                int u = edge[i][0];
                int v = edge[i][1];
                int w = edge[i][2];

                if (dp[e - 1][u] != INF)
                    dp[e][v] = Math.min(dp[e][v], dp[e - 1][u] + w);

                if (dp[e - 1][v] != INF)
                    dp[e][u] = Math.min(dp[e][u], dp[e - 1][v] + w);
            }
        }

        int ans = INF;

        for (int e = 0; e <= k; e++) {
            ans = Math.min(ans, dp[e][n]);
        }

        if (ans == INF)
            System.out.println(-1);
        else
            System.out.println(ans);

        sc.close();
    }
}




