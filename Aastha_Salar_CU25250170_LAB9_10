import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter N: ");
        int n = sc.nextInt();
        int[] a = new int[n];
        System.out.println("Enter elements:");
        for (int i = 0; i < n; i++)
            a[i] = sc.nextInt();
        for (int i = 1; i < n; i++) {
            if (a[i] != a[0]) {
                System.out.println(-1);
                return;
            }
        }
        System.out.println(Math.abs(a[0]));
    }
}
